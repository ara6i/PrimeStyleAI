+  assert.deepEqual(detail.sectionResult.availableSizes, ['EU 39']);
+  assert.deepEqual(companionSizingDetail({ title: 'Bag', image: '/bag.webp', recommendedSize: 'One size' }).sectionResult.oneSize, true);
