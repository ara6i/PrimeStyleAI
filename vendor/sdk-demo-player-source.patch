+  const detail = companionSizingDetail({ title: 'Trouser', image: '/trouser.webp', recommendedSize: '34', availableSizes: ['32', '34'], sizeGuide });
+  assert.equal(detail.section.headers, sizeGuide.headers);
+  assert.equal(detail.section.rows, sizeGuide.rows);
+  assert.deepEqual(detail.sectionResult.availableSizes, ['32', '34']);
+  assert.equal(detail.sectionResult.recommendedSize, '34');
+  assert.deepEqual(detail.sectionResult.matchDetails, []);
+  assert.deepEqual(detail.userMeasurements, {});
