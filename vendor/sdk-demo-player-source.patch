+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { preparedSizingResult } from '../src/react/utils/prepared-sizing.ts';
+import { buildSectionFitRows } from '../src/react/utils/section-fit-rows.ts';
+
+test('prepared sizing never claims measured body values, fit, or high confidence', () => {
+  for (const size of ['M', '29', 'EU 38', 'One size']) {
+    const result = preparedSizingResult(size, 'cm');
+    assert.equal(result.recommendedSize, size);
+    assert.equal(result.confidence, 'illustrative');
+    assert.equal(result.isPreparedDemo, true);
+    assert.deepEqual(result.matchDetails, []);
+    assert.equal(result.method, undefined);
+    assert.equal(result.found, undefined);
+  }
+});
+
+test('a women’s coat chart uses its own body ranges and garment lengths without a men’s jacket comparison', () => {
+  const result = preparedSizingResult('M', 'cm');
+  const rows = buildSectionFitRows({
+    section: { headers: ['Size', 'Bust body range (cm)', 'Waist body range (cm)', 'Garment sleeve (cm)'], rows: [['M', '89–93', '71–75', '61']] },
+    selectedSize: 'M', recommendedSize: result.recommendedSize,
+    matchDetails: result.matchDetails, userMeasurements: {}, resultUnit: 'cm',
+  });
+  assert.deepEqual(rows.map(row => row.chartLabel), ['89-93', '71-75', '61']);
+  assert.ok(rows.every(row => row.fit === 'unavailable' && row.userNum === 0));
+});
