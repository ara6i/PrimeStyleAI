+import type { SizingResult } from "../../types";
+
+/** A prepared image and sample size do not establish a shopper's measurements. */
+export function preparedSizingResult(recommendedSize: string, unit: "cm" | "in"): SizingResult {
+  return {
+    recommendedSize,
+    confidence: "illustrative",
+    reasoning: "Sample size for this prepared demo. Check the product's verified size chart and your body measurements before choosing a size.",
+    unit,
+    isPreparedDemo: true,
+    matchDetails: [],
+  };
+}
