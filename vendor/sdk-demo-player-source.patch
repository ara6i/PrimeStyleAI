+import { useEffect, useRef, useState, type RefObject } from "react";
+
+/** Only mounted for hosts with a complete, prepared demo. Never submits a live job. */
+export function GuidedDemoPlayer({ rootRef, playing, resultReady, onStart, onPlayingChange }: {
+  rootRef: RefObject<HTMLDivElement>;
+  playing: boolean;
+  resultReady: boolean;
+  onStart: () => void;
+  onPlayingChange: (playing: boolean) => void;
+}) {
+  const [phase, setPhase] = useState("Watch the demo, then explore the garments and size charts.");
+  const [hasPlayed, setHasPlayed] = useState(false);
+  const [cursor, setCursor] = useState<{ x: number; y: number; pressed: boolean } | null>(null);
+  const readyRef = useRef(resultReady);
+  readyRef.current = resultReady;
+
+  useEffect(() => {
+    if (!playing) { setCursor(null); return; }
+    const controller = new AbortController();
+    const signal = controller.signal;
+    const timers = new Set<ReturnType<typeof setTimeout>>();
+    const wait = (ms: number) => new Promise<void>((resolve, reject) => {
+      if (signal.aborted) { reject(new Error("cancelled")); return; }
+      const cancel = () => { clearTimeout(timer); timers.delete(timer); reject(new Error("cancelled")); };
+      const timer = setTimeout(() => { timers.delete(timer); signal.removeEventListener("abort", cancel); resolve(); }, ms);
+      timers.add(timer);
+      signal.addEventListener("abort", cancel, { once: true });
+    });
+    const find = async (selector: string, predicate?: () => boolean) => {
+      const deadline = Date.now() + 30_000;
+      while (!signal.aborted && Date.now() < deadline) {
+        const element = rootRef.current?.querySelector<HTMLElement>(selector);
+        if (element && element.getClientRects().length && (!predicate || predicate())) return element;
+        await wait(100);
+      }
+      throw new Error("step unavailable");
+    };
+    const click = async (element: HTMLElement) => {
+      element.scrollIntoView({ block: "nearest", behavior: "instant" });
+      await wait(120);
+      const rect = element.getBoundingClientRect();
+      setCursor({ x: rect.left + rect.width / 2, y: rect.top + rect.height / 2, pressed: false });
+      await wait(380);
+      if (!element.isConnected || signal.aborted) throw new Error("step unavailable");
+      setCursor(current => current && { ...current, pressed: true });
+      await wait(140);
+      element.click();
+      setCursor(current => current && { ...current, pressed: false });
+      await wait(250);
+    };
+    setHasPlayed(true);
+    setPhase("1 of 4 · Set up the sample profile");
+    void (async () => {
+      // Desktop's profile cursor fills and submits the form. Mobile uses its
+      // preset fields and the same visible, real button clicks as later steps.
+      if (window.matchMedia("(max-width: 767px)").matches) {
+        await click(await find(".ps-pm-primary-btn:not(:disabled)"));
+        await click(await find('[data-demo-step="scan-details"] .ps-bpm-next-btn:not(:disabled)'));
+      }
+      await find(".ps-bp-style-submit:not(:disabled)");
+      setPhase("2 of 4 · Build the outfit");
+      await wait(450);
+      const category = rootRef.current?.querySelectorAll<HTMLElement>(".ps-bp-outfit-piece-open")[1];
+      if (category) await click(category);
+      const nextOptions = rootRef.current?.querySelector<HTMLElement>(".ps-bp-outfit-option-nav.ps-next");
+      if (nextOptions) await click(nextOptions);
+      const nextLook = rootRef.current?.querySelector<HTMLElement>(".ps-bp-outfit-carousel-controls .ps-next:not(:disabled)");
+      if (nextLook) await click(nextLook);
+      await click(await find(".ps-bp-style-submit:not(:disabled)"));
+      setPhase("3 of 4 · Reveal the prepared look");
+      setCursor(null);
+      const garment = await find(".ps-rag-result-garment-card", () => readyRef.current);
+      setPhase("4 of 4 · Explore the size chart");
+      await wait(700);
+      await click(garment);
+      await find(".ps-msd-root, .ps-tryon-sec-detail, .ps-outfit-size-detail, .ps-outfit-size-note");
+      await wait(900);
+      // Show the chart, then hand back the garment selector. Every control is live.
+      const back = rootRef.current?.querySelector<HTMLElement>(".ps-msd-back, .ps-msd-action-back, .ps-outfit-size-footer .ps-bp-back-btn, .ps-tryon-sec-detail-footer .ps-bp-back-btn");
+      if (back) await click(back);
+      setPhase("Your turn · Select a garment to view its sizes and details.");
+      onPlayingChange(false);
+    })().catch(() => {
+      if (!signal.aborted) {
+        setPhase("Demo paused · Continue with the controls below or replay.");
+        onPlayingChange(false);
