+import type { StyleMatchSelection } from "../../api-client";
+
+/** The companion's size choices and measurements cannot come from the anchor. */
+export function companionSizingDetail(piece: StyleMatchSelection) {
+  const availableSizes = piece.availableSizes?.length
+    ? piece.availableSizes
+    : piece.sizeGuide?.rows.map(row => row[0]).filter(Boolean)
+      || (piece.recommendedSize ? [piece.recommendedSize] : []);
+  return {
+    section: { requiredFields: [], ...(piece.sizeGuide || { headers: ["Size"], rows: availableSizes.map(size => [size]) }) },
+    sectionResult: {
+      recommendedSize: piece.recommendedSize || "",
+      matchDetails: [],
+      availableSizes,
+      oneSize: availableSizes.length === 1 && /^one\s*size$/i.test(availableSizes[0]),
+    },
+    userMeasurements: {} as Record<string, number>,
+  };
+}
