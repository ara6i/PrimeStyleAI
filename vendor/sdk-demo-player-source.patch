+type Translate = (text: string) => string;
+
+export function fitLabel(fit: string, t: Translate): string {
+  const labels: Record<string, string> = {
+    good: "within range", "too-tight": "too tight", tight: "tight",
+    "a-bit-tight": "a bit tight", "too-loose": "too loose", loose: "loose",
+    "a-bit-loose": "a bit loose",
+  };
+  return t(labels[fit] || "Not available");
+}
+
+export function lengthFitLabel(fit: string, t: Translate): string {
+  const labels: Record<string, string> = {
+    good: "within range", "too-short": "too short", "too-tight": "too short",
+    short: "short", tight: "short", "a-bit-short": "a bit short", "a-bit-tight": "a bit short",
+    "too-long": "too long", "too-loose": "too long", long: "long", loose: "long",
+    "a-bit-long": "a bit long", "a-bit-loose": "a bit long",
+  };
+  return t(labels[fit] || "Not available");
+}
